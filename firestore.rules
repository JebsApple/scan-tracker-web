rules_version = '2';

// Modelo actual: cada usuario tiene un único documento con sus preferencias
// (series vinculadas y aliases). Nadie lee ni escribe el de otro.
//
// Todo lo que no esté declarado acá queda denegado por defecto — cuando se
// agreguen series compartidas hay que abrirlas explícitamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Catálogo compartido de series (nombre + hoja). Por ahora solo lectura:
    // ninguna UI de este repo escribe acá todavía — dejar create/update/delete
    // cerrados hasta que haya una feature real que los necesite.
    match /series/{seriesId} {
      allow read: if request.auth != null;
    }
  }
}
